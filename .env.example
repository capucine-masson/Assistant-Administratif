# ============================================================
# Copiez ce fichier en ".env" (jamais commité, voir .gitignore)
# et remplissez les valeurs. Aucun secret ne doit être en dur
# dans le code.
# ============================================================

# Clé utilisée pour signer les cookies de session (auth factice).
# Générez-en une avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-secret

# Base de données SQLite (fichier dans ./data, monté en volume Docker
# pour survivre aux rebuilds de l'image)
DATABASE_URL=sqlite:///./data/app.db

# Port exposé sur votre machine (nginx écoute dessus en local)
APP_PORT=9090

# --------------------------------------------------------------
# Fournisseur LLM utilisé pour estimer difficulté/temps et générer
# les guides détaillés des démarches.
# Valeurs possibles : "groq" | "none"
#
# - "none" : aucune IA, utilise des règles simples déjà en dur dans
#            le catalogue (fonctionne sans clé).
# - "groq" : API cloud gratuite, voir README pour obtenir une clé.
# --------------------------------------------------------------
LLM_PROVIDER=none

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
